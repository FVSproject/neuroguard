# --- Supabase --------------------------------------------------------------
# https://supabase.com/dashboard → your project → Project Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL       = "Project URL"   (safe to expose)
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = "anon public"   (safe to expose;
#                                                     RLS enforces per-user
#                                                     access on the DB side)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...<paste anon key>..."
