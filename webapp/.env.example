# --- Neon (Postgres) --------------------------------------------------------
# Get these from https://console.neon.tech → your project → Connection Details.
# `DATABASE_URL` is the pooled connection; `DIRECT_URL` is the direct one used
# by `prisma migrate`.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Clerk (auth) -----------------------------------------------------------
# Get these from https://dashboard.clerk.com → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk sends signed-in users. Leave defaults unless you know why.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/live"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/profile/new"
